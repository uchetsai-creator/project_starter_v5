# Generated context — not committed; recreate with: python3 orchestrator.py
.ai/
# .ai/AI_CONTEXT.md          — written by build-context.py (called internally by orchestrator.py)
# .ai/WORKFLOW.md             — written by orchestrator.py
# .ai/telemetry/              — validator run logs (validation-result.json, written by --telemetry flag)

__pycache__/
*.pyc
.pytest_cache/

# npm install --no-save eslint eslint-plugin-security (for verify_security.py's JS/TS scan
# and its CI/tests) — no package.json is committed, so this is always throwaway local state.
node_modules/

# Runtime logs — generated by .githooks/run-verify.sh and adapters/claude/stop-hook.sh, not committed
# logs/verify-*.json    — per-session validator output (run-verify.sh)
# logs/telemetry/       — session boundary and orchestrator run telemetry (stop-hook.sh)
logs/

# verify_security.py's throwaway eslint flat config — written to cwd (not an OS temp dir,
# see _run_eslint()'s docstring for why) and removed in a finally block; this pattern is
# only a safety net for the rare case a run gets killed before cleanup runs.
.eslint-security-*.config.cjs

# generate_openapi.py writes openapi.yaml as a generated artifact derived from
# api-contract.md — regenerate it, don't hand-edit it (same lifecycle as .ai/AI_CONTEXT.md
# above). NOT ignored by default: some projects deliberately commit it (client codegen, doc
# hosting) — uncomment the line below if yours doesn't need to.
# openapi.yaml
