{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 adapters/claude/pretooluse_scope_guard.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .githooks/run-verify.sh"
          },
          {
            "type": "command",
            "command": "bash adapters/claude/stop-hook.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash adapters/claude/session-start-hook.sh 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "python3 adapters/claude/learning_log_nudge.py 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
