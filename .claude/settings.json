{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .githooks/run-verify.sh"
          },
          {
            "type": "command",
            "command": "bash adapters/claude/stop-hook.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash adapters/claude/session-start-hook.sh 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
