#!/usr/bin/env bash
# project_starter_v5 — verification pre-commit hook
# Runs quality checks automatically on every git commit. Blocks on failure.
#
# Install (once per project clone):
#   cp .githooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# Requires .project-starter.yml at the project root with:
#   project_type: <your-type>
#   docs_path: docs/
#
# Prototyping/spike escape hatch:
#   PROJECT_STARTER_SKIP_VERIFY=1 git commit -m "wip"
#   Skips every check below for that one commit. Prefer this over `git commit --no-verify` —
#   --no-verify skips this hook silently with no trace in the commit; the env var still
#   prints a loud [SKIP] line, and also appends a row to logs/telemetry/skip-verify.json,
#   so a skipped commit is never mistaken for a verified one — and how often this project
#   uses the hatch is auditable after the fact, not just visible in the terminal at the
#   moment it happened.

set -euo pipefail

# ── Prototyping/spike escape hatch ────────────────────────────────────────────
# Trigger: PROJECT_STARTER_SKIP_VERIFY set to any non-empty value.
# Deliberately loud (always prints) so skipping never becomes an invisible habit.
# The telemetry row does not make this harder to bypass — a determined agent/developer
# can still delete or never read logs/telemetry/skip-verify.json, same as any local log.
# It exists so a human auditing the project later has a record at all, rather than nothing.
if [ -n "${PROJECT_STARTER_SKIP_VERIFY:-}" ]; then
    echo "[SKIP] pre-commit: PROJECT_STARTER_SKIP_VERIFY is set — all checks skipped for this commit."
    if command -v python3 &>/dev/null; then
        STAGED_COUNT=$(git diff --cached --name-only 2>/dev/null | grep -c . || true)
        PSV_STAGED_COUNT="$STAGED_COUNT" python3 -c "
import json, os
from datetime import datetime, timezone
path = os.path.join('logs', 'telemetry', 'skip-verify.json')
os.makedirs(os.path.dirname(path), exist_ok=True)
rows = []
if os.path.exists(path):
    try:
        with open(path, encoding='utf-8') as f:
            rows = json.load(f)
        if not isinstance(rows, list):
            rows = []
    except (json.JSONDecodeError, OSError):
        rows = []
entry = {
    'ts': datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),
    'staged_files': int(os.environ.get('PSV_STAGED_COUNT', '0') or '0'),
}
rows.append(entry)
with open(path, 'w', encoding='utf-8') as f:
    json.dump(rows, f, indent=2)

# Optional OTel dual-emission (see docs/script/validators/_otel.py's docstring) —
# no-ops unconditionally unless opentelemetry-* is installed and
# OTEL_EXPORTER_OTLP_ENDPOINT is set; the local JSON write above is unaffected either way.
import sys
for _candidate in ('docs/script/validators', 'templates/script/validators'):
    if os.path.isdir(_candidate):
        sys.path.insert(0, _candidate)
        break
try:
    from _otel import emit as _otel_emit
    _otel_emit('skip-verify', entry)
except ImportError:
    pass
" 2>/dev/null || true
    fi
    exit 0
fi

# Staged file list — collected once, used by multiple checks
STAGED=$(git diff --cached --name-only 2>/dev/null || true)

# Validates a "**Clarifying Questions Asked:**" line's value against the documented
# vocabulary (Y or N/A — see current-state.md template). A presence-only check would
# accept any text at all, including an honest "N" (never a valid value) or a one-word
# throwaway — this at least forces the right vocabulary. It still cannot verify a real
# Q&A actually happened; no text-presence check can settle that, only the agent/human
# choosing to be truthful can (see README/AGENTS.md for the human-facing caveat).
_cqa_value_is_valid() {
    value=$(printf '%s' "$1" | sed 's/^\*\*Clarifying Questions Asked:\*\*[[:space:]]*//')
    printf '%s' "$value" | grep -qiE '^(Y|N/A)([^A-Za-z]|$)'
}

# ── Registry schema ───────────────────────────────────────────────────────────
# Trigger: always (registry is the shared dependency of all validators)
# Catches: malformed project type (webapp vs web-app), missing required fields, bad values
if command -v python3 &>/dev/null && [ -f "templates/script/validators/verify_registry.py" ] && [ -f "document-registry.yaml" ]; then
    echo "  → verify_registry.py ..."
    python3 "templates/script/validators/verify_registry.py" --registry document-registry.yaml 2>&1 || {
        echo "[FAIL] pre-commit: registry schema validation failed — commit blocked."
        exit 1
    }
fi

# ── Framework integrity ────────────────────────────────────────────────────────
# Trigger: running inside the project_starter_v5 framework repo (templates/script/ present)
# Catches: stale pointer, matrix gap, or token budget violation
if command -v python3 &>/dev/null && [ -f "templates/script/framework/verify_framework.py" ]; then
    echo "  → verify_framework.py --strict ..."
    python3 "templates/script/framework/verify_framework.py" --strict 2>&1 || {
        echo "[FAIL] pre-commit: framework integrity check failed — commit blocked."
        exit 1
    }
fi

# ── Read .project-starter.yml ─────────────────────────────────────────────────
CONFIG=".project-starter.yml"
PROJECT_TYPE=""
DOCS_PATH="docs"

SPEC_CODE_ADAPTER=""
SPEC_CODE_SPEC=""
SPEC_CODE_SRC=""
SPEC_CODE_BINDINGS=""
SECURITY_SCAN_SRC=""
PROSE_SCAN_ENABLED=""
TEST_COMMAND=""

if [ -f "$CONFIG" ]; then
    PROJECT_TYPE=$(grep '^project_type:' "$CONFIG" | sed 's/project_type:[[:space:]]*//' | tr -d "\"' ")
    DOCS_CANDIDATE=$(grep '^docs_path:' "$CONFIG" | sed 's/docs_path:[[:space:]]*//' | tr -d "\"' /")
    [ -n "$DOCS_CANDIDATE" ] && DOCS_PATH="$DOCS_CANDIDATE"
    SPEC_CODE_ADAPTER=$(grep '^spec_code_adapter:' "$CONFIG" | sed 's/spec_code_adapter:[[:space:]]*//' | tr -d "\"' ") || true
    SPEC_CODE_SPEC=$(grep '^spec_code_spec:' "$CONFIG" | sed 's/spec_code_spec:[[:space:]]*//' | tr -d "\"' ") || true
    SPEC_CODE_SRC=$(grep '^spec_code_src:' "$CONFIG" | sed 's/spec_code_src:[[:space:]]*//' | tr -d "\"' ") || true
    # Resolves spec_code_bindings (the multi-contract list form) OR the legacy single
    # trio above into "adapter<TAB>spec<TAB>src" lines, one per binding. Delegates to
    # orchestrator.py's already-tested _resolve_spec_code_bindings() instead of
    # re-parsing a nested YAML list with grep/sed here — bash pattern-matching a flat
    # "key: value" line is a fundamentally different (and much safer) problem than
    # parsing a YAML list of mappings; get it wrong here and every commit on every
    # project using this framework is affected. Empty output (missing orchestrator.py,
    # unparsable config, zero bindings) degrades to "no spec<->code gate configured" —
    # same as today's behavior when the legacy trio is unset.
    if [ -f "orchestrator.py" ]; then
        SPEC_CODE_BINDINGS=$(python3 -c "
import sys
import pathlib
sys.path.insert(0, '.')
try:
    from orchestrator import _load_yaml, _resolve_spec_code_bindings
    cfg = _load_yaml(pathlib.Path(sys.argv[1]))
    for b in _resolve_spec_code_bindings(cfg):
        print(b['adapter'] + '\t' + b['spec'] + '\t' + b['src'])
except Exception:
    pass
" "$CONFIG" 2>/dev/null) || SPEC_CODE_BINDINGS=""
        # Strip any \r — on native Windows, Python's stdout is opened in text mode and
        # translates \n to \r\n; bash's `read` below only consumes the \n, leaving a
        # trailing \r stuck to each line's last field (src). That \r then makes every
        # `grep -F "$B_SRC"` staged-file match fail silently — a false negative (the
        # gate never fires), not a crash, so it doesn't show up as an error. Confirmed
        # by actually staging a file under a binding's src on Windows and observing the
        # gate not fire before this line was added.
        SPEC_CODE_BINDINGS="${SPEC_CODE_BINDINGS//$'\r'/}"
    else
        SPEC_CODE_BINDINGS=""
    fi
    SECURITY_SCAN_SRC=$(grep '^security_scan_src:' "$CONFIG" | sed 's/security_scan_src:[[:space:]]*//' | tr -d "\"' ") || true
    PROSE_SCAN_ENABLED=$(grep '^prose_scan_enabled:' "$CONFIG" | sed 's/prose_scan_enabled:[[:space:]]*//' | tr -d "\"' ") || true
    # Not tr -d "'\" " here — unlike the fields above, a real command legitimately
    # contains spaces and quotes (e.g. python3 -c "..."), so the raw value is used
    # as-is (just trimmed of leading whitespace after the YAML key) instead of
    # stripping characters that could be part of the command itself.
    TEST_COMMAND=$(grep '^test_command:' "$CONFIG" | sed -E 's/^test_command:[[:space:]]*//') || true
fi

# ── spec_code_adapter value guard (legacy single trio) ────────────────────────
# Catches: a typo'd adapter name, checked as soon as spec_code_adapter itself is set —
# independent of whether spec_code_spec / spec_code_src are also filled in yet. This is
# deliberately NOT folded into the resolved-bindings guard below: _resolve_spec_code_bindings()
# only returns a binding once all three fields are present, so a project that's set the
# adapter but hasn't finished filling in spec/src yet would otherwise get zero feedback
# on a typo'd adapter name until the other two fields are also filled in. Confirmed by
# tests/unit/test_pre_commit_skip_verify.py's blocking-config fixture, which sets exactly
# this (adapter filled, spec/src blank) and expects the typo to be caught immediately.
KNOWN_ADAPTERS="fastapi flask django express gin click typer airflow dagster prefect luigi python_library typescript tool_schema langchain terraform pulumi ansible react_native flutter swiftui python_logging javascript_logging"
if [ -n "$SPEC_CODE_ADAPTER" ]; then
    ADAPTER_VALID=false
    for known in $KNOWN_ADAPTERS; do
        [ "$SPEC_CODE_ADAPTER" = "$known" ] && ADAPTER_VALID=true && break
    done
    if [ "$ADAPTER_VALID" = false ]; then
        echo "[FAIL] pre-commit: spec_code_adapter '$SPEC_CODE_ADAPTER' is not a recognised adapter."
        echo "    Known adapters: $KNOWN_ADAPTERS"
        echo "    Fix the value in .project-starter.yml or leave spec_code_adapter blank to disable the gate."
        exit 1
    fi
fi

# ── spec_code_bindings adapter guard (resolved bindings, either config form) ──
# Catches the same typo, but for every *complete* resolved binding — covers
# spec_code_bindings entries the check above can't see (it only reads the legacy
# trio's raw value). An incomplete spec_code_bindings entry (adapter set, spec or src
# missing) is silently dropped by _resolve_spec_code_bindings() rather than checked
# here — same documented scope boundary as that function's docstring.
if [ -n "$SPEC_CODE_BINDINGS" ]; then
    while IFS=$'\t' read -r B_ADAPTER B_SPEC B_SRC; do
        [ -z "$B_ADAPTER" ] && continue
        ADAPTER_VALID=false
        for known in $KNOWN_ADAPTERS; do
            [ "$B_ADAPTER" = "$known" ] && ADAPTER_VALID=true && break
        done
        if [ "$ADAPTER_VALID" = false ]; then
            echo "[FAIL] pre-commit: spec_code adapter '$B_ADAPTER' is not a recognised adapter."
            echo "    Known adapters: $KNOWN_ADAPTERS"
            echo "    Fix the value in .project-starter.yml (spec_code_adapter, or the matching"
            echo "    entry in spec_code_bindings)."
            exit 1
        fi
    done <<< "$SPEC_CODE_BINDINGS"
fi

if [ -z "$PROJECT_TYPE" ]; then
    echo "[WARN] pre-commit: .project-starter.yml not found or project_type missing — skipping verification."
    exit 0
fi

# ── Placeholder guard ─────────────────────────────────────────────────────────
# Catches: committing with the template placeholder value still in project_type
if echo "$PROJECT_TYPE" | grep -qE '^\[.+\]$'; then
    echo "[FAIL] pre-commit: .project-starter.yml project_type is still a placeholder ('$PROJECT_TYPE')."
    echo "    Replace it with your actual project type before committing."
    echo "    Valid values: web-app | cli-tool | library | data-pipeline | ml-pipeline | microservices | llm-app | iac | mobile-app"
    exit 1
fi

echo "pre-commit: project-type=$PROJECT_TYPE  docs=$DOCS_PATH"
PASS=true

# ── project_type confirmation guard ─────────────────────────────────────────────
# Trigger: .project-starter.yml has a `project_type_confirmed: false` line — written by
# detect_type.py --apply to mark project_type as an unverified machine guess (see that
# script's --force flag help text / AGENTS.md -> New requirement from the user). Absent
# entirely means either a human wrote project_type by hand (a human decision doesn't need
# re-confirming) or the file predates this field — not retroactively broken either way.
# Catches: a detect_type.py recommendation that passed the confidence gate but is still
# wrong (mixed signals in the scan) getting applied and silently trusted, because a
# confidence threshold alone only catches the low-confidence case — see docs/architecture-
# analysis.md for why that gap needed a second, independent gate rather than a higher
# threshold.
if [ -f "$CONFIG" ] && grep -qE '^project_type_confirmed:[[:space:]]*false' "$CONFIG"; then
    echo "  [FAIL] project_type_confirmed: false in $CONFIG — detect_type.py's guess hasn't been confirmed yet."
    echo "         Confirm the detected project_type is actually correct, then set"
    echo "         project_type_confirmed: true (or remove the line) before committing —"
    echo "         see AGENTS.md -> New requirement from the user."
    PASS=false
fi

# ── Unscoped source-change guard ───────────────────────────────────────────────
# Trigger: any staged file that isn't docs/, guidance/, .githooks/, .claude/, .codex/,
# adapters/, logs/, .ai/, or one of the known framework root files — i.e. it looks like
# application source/config actually being changed.
# Catches: the "Clarifying Questions Asked guard" further below only runs at all when
# docs/current-state.md is itself part of the staged set — an agent that implements a new,
# unscoped requirement and simply never stages current-state.md sails through that check
# untouched. This gate closes that gap: it looks at whatever version of current-state.md
# would actually be in the repo after this commit (staged if staged, else the committed
# HEAD version) regardless of whether that file is part of this commit, so "don't touch
# current-state.md" stops being a way around scoping a task before writing code.
NON_SOURCE_REGEX="^(${DOCS_PATH}/|guidance/|\.githooks/|\.claude/|\.codex/|adapters/|logs/|\.ai/|AGENTS\.md|CLAUDE\.md|orchestrator\.py|build-context\.py|_workflow_utils\.py|workflow-registry\.yaml|document-registry\.yaml|detect_type\.py|debug-instrumentation-rules\.md|code-quality-check\.md|learning-log\.md|\.project-starter\.yml|README\.md|LICENSE|\.gitignore|\.pre-commit-config\.yaml)"
SOURCE_STAGED=$(printf '%s\n' "$STAGED" | grep -vE "$NON_SOURCE_REGEX" || true)
if [ -n "$SOURCE_STAGED" ]; then
    CS_PATH="${DOCS_PATH}/current-state.md"
    if printf '%s\n' "$STAGED" | grep -qxF "$CS_PATH"; then
        SCOPE_CS_CONTENT=$(git show ":$CS_PATH" 2>/dev/null || true)
    else
        SCOPE_CS_CONTENT=$(git show "HEAD:$CS_PATH" 2>/dev/null || true)
    fi
    SCOPE_TASK=$(printf '%s\n' "$SCOPE_CS_CONTENT" | grep -E '^\*\*Task:\*\*' | head -1 || true)
    if [ -z "$SCOPE_CS_CONTENT" ] || [ -z "$SCOPE_TASK" ] || printf '%s\n' "$SCOPE_TASK" | grep -qE '\['; then
        echo "  [FAIL] Source files staged (e.g. \"$(printf '%s\n' "$SOURCE_STAGED" | head -1)\") but $CS_PATH has no scoped Current Task."
        echo "         Ask scope/edge-case/acceptance-criteria questions and set Current Task before implementing —"
        echo "         see AGENTS.md -> New requirement from the user."
        PASS=false
    else
        SCOPE_CQA=$(printf '%s\n' "$SCOPE_CS_CONTENT" | grep -E '^\*\*Clarifying Questions Asked:\*\*' | head -1 || true)
        if [ -z "$SCOPE_CQA" ] || printf '%s\n' "$SCOPE_CQA" | grep -qE '\[' || ! _cqa_value_is_valid "$SCOPE_CQA"; then
            echo "  [FAIL] Source files staged but Clarifying Questions Asked is unfilled or not Y/N/A in $CS_PATH."
            echo "         Set it to Y or N/A before committing — see AGENTS.md -> New requirement from the user."
            PASS=false
        fi
    fi
fi

# 1. Document completeness + content quality
if command -v python3 &>/dev/null && [ -f "docs/script/validators/verify_docs.py" ]; then
    echo "  → verify_docs.py --content ..."
    python3 "docs/script/validators/verify_docs.py" \
        --project-type "$PROJECT_TYPE" --docs "$DOCS_PATH" --content --strict 2>&1 || PASS=false
else
    echo "  [WARN] docs/script/validators/verify_docs.py not found — skipping"
fi

# 2. Log quality
if [ -f "docs/script/validators/verify_logs.py" ]; then
    echo "  → verify_logs.py ..."
    python3 "docs/script/validators/verify_logs.py" \
        --project-type "$PROJECT_TYPE" --docs "$DOCS_PATH" --strict 2>&1 || PASS=false
fi

# 3. Test report quality
if [ -f "docs/script/validators/verify_tests.py" ]; then
    echo "  → verify_tests.py ..."
    python3 "docs/script/validators/verify_tests.py" \
        --project-type "$PROJECT_TYPE" --docs "$DOCS_PATH" --strict 2>&1 || PASS=false
fi

# 4. Document content quality
if [ -f "docs/script/validators/verify_content.py" ]; then
    echo "  → verify_content.py ..."
    python3 "docs/script/validators/verify_content.py" \
        --project-type "$PROJECT_TYPE" --docs "$DOCS_PATH" --strict 2>&1 || PASS=false
fi

# 5. Test suite execution
# Trigger: test_command set in .project-starter.yml
# Catches what verify_tests.py (step 3) cannot — that check only looks at whether
# docs/specs/test-report.md has non-placeholder numbers, it never runs anything, so a
# fabricated "42 passed" line satisfies it. This actually executes the configured test
# command and blocks the commit on a real failure or on the command not existing.
if [ -n "$TEST_COMMAND" ]; then
    echo "  → running test suite: $TEST_COMMAND ..."
    if bash -c "$TEST_COMMAND"; then
        echo "  [OK] test suite passed"
    else
        echo "  [FAIL] test suite failed (command: $TEST_COMMAND) — commit blocked."
        PASS=false
    fi
fi

# ── AGENTS.md token budget ─────────────────────────────────────────────────────
# Trigger: AGENTS.md in staged files
# Catches: AGENTS.md growing past the 200-line limit
AGENTS_FILE=$(printf '%s\n' "$STAGED" | grep -E '(^|/)AGENTS\.md$' | head -1 || true)
if [ -n "$AGENTS_FILE" ]; then
    AGENTS_LINES=$(git show ":$AGENTS_FILE" 2>/dev/null | wc -l || echo 0)
    if [ "$AGENTS_LINES" -gt 200 ]; then
        echo "  [FAIL] AGENTS.md is $AGENTS_LINES lines — token budget exceeded (limit: 200)"
        PASS=false
    else
        echo "  [OK] AGENTS.md token budget OK ($AGENTS_LINES / 200 lines)"
    fi
fi

# ── Changelog audit trail ──────────────────────────────────────────────────────
# Trigger: any specs/*.md or architecture/*.md staged
# Severity: warn (non-blocking) — reminder only
# Catches: silent spec changes with no audit trail entry in changelog.md
SPEC_ARCH_STAGED=$(printf '%s\n' "$STAGED" | grep -E '(specs/|architecture/).*\.md$' || true)
if [ -n "$SPEC_ARCH_STAGED" ]; then
    CHANGELOG_STAGED=$(printf '%s\n' "$STAGED" | grep -E '(^|/)changelog\.md$' | head -1 || true)
    if [ -z "$CHANGELOG_STAGED" ]; then
        echo "  [WARN] spec or architecture files changed without changelog.md — add an audit trail entry"
    fi
fi

# ── Closeout completeness ──────────────────────────────────────────────────────
# Trigger: current-state.md staged with Status containing "Complete"
# Catches: task marked done but Closeout section left with unfilled placeholders
CS_FILE=$(printf '%s\n' "$STAGED" | grep -E '(^|/)current-state\.md$' | head -1 || true)
if [ -n "$CS_FILE" ]; then
    CS_CONTENT=$(git show ":$CS_FILE" 2>/dev/null || true)
    CS_STATUS=$(printf '%s\n' "$CS_CONTENT" | grep -iE '^\*\*Status:\*\*' | head -1 || true)
    if printf '%s\n' "$CS_STATUS" | grep -qi 'Complete'; then
        CLOSEOUT_SECTION=$(printf '%s\n' "$CS_CONTENT" | awk '/^## Closeout/{p=1} p{print}')
        if printf '%s\n' "$CLOSEOUT_SECTION" | grep -qE '__+|<!--'; then
            echo "  [FAIL] current-state.md Status is Complete but Closeout section has unfilled placeholders (___) or comments (<!--)"
            PASS=false
        fi

        # ── Doc Checklist completeness ──────────────────────────────────────
        # Trigger: same as above (Status contains "Complete").
        # Catches: a task marked Complete while its own Doc Checklist still has an
        # unchecked item (- [ ]) or the raw, never-customized template placeholder
        # (`[relevant spec]`) — i.e. the per-task doc-update list AGENTS.md -> "Closing
        # out a task" says to apply at closeout was never actually gone through.
        # Reuses the checklist's own - [ ] / - [x] state directly rather than adding a
        # separate summary field (e.g. a "Doc Checklist Applied: Y/N/A" flag) — a second,
        # independently-settable field would just be one more thing that could say "done"
        # without the underlying items actually being checked off; the checkboxes already
        # ARE the record of what happened, so trust that instead of a field a duplicate of it.
        DOC_CHECKLIST_SECTION=$(printf '%s\n' "$CS_CONTENT" | awk '/^## Doc Checklist/{p=1} /^## Closeout/{p=0} p{print}')
        if printf '%s\n' "$DOC_CHECKLIST_SECTION" | grep -qE '^- \[ \]|\[relevant spec\]'; then
            echo "  [FAIL] current-state.md Status is Complete but Doc Checklist has an unchecked item"
            echo "         (- [ ]) or the unfilled template placeholder (\`[relevant spec]\`)."
            echo "         Apply each Doc Checklist item and check it off (- [x]) before marking the"
            echo "         task Complete — see AGENTS.md -> Closing out a task."
            PASS=false
        fi
    fi

    # ── Clarifying Questions Asked guard ────────────────────────────────────
    # Trigger: Current Task's **Task:** field is a real (non-placeholder) task.
    # Catches: a real task set up without recording whether Checkpoint B's clarifying
    # questions happened — see AGENTS.md -> New requirement from the user.
    CS_TASK=$(printf '%s\n' "$CS_CONTENT" | grep -E '^\*\*Task:\*\*' | head -1 || true)
    if [ -n "$CS_TASK" ] && ! printf '%s\n' "$CS_TASK" | grep -qE '\['; then
        CS_CQA=$(printf '%s\n' "$CS_CONTENT" | grep -E '^\*\*Clarifying Questions Asked:\*\*' | head -1 || true)
        if [ -z "$CS_CQA" ] || printf '%s\n' "$CS_CQA" | grep -qE '\[' || ! _cqa_value_is_valid "$CS_CQA"; then
            echo "  [FAIL] current-state.md has a real Current Task but Clarifying Questions Asked is missing, still a placeholder, or not Y/N/A"
            echo "         Set it to Y (asked before implementing) or N/A (pre-scoped task / Checkpoint A applied) — see AGENTS.md -> New requirement from the user."
            PASS=false
        fi
    fi
fi

# ── Writing Audience violations ────────────────────────────────────────────────
# Trigger: any spec-facing document staged
# Spec-facing: business-rules.md, pipeline-contract.md, research.md, quickstart.md,
#              architecture/*.md, modules/*/*-module-data-flow.md
# Catches: sprint/task references written into stakeholder-facing documents
SPEC_FACING_STAGED=$(printf '%s\n' "$STAGED" | grep -E \
    '(business-rules|pipeline-contract|research|quickstart)\.md$|(^|/)architecture/.*\.md$|modules/.*-module-data-flow\.md$' \
    || true)
if [ -n "$SPEC_FACING_STAGED" ]; then
    FOUND_VIOLATIONS=false
    while IFS= read -r file; do
        [ -z "$file" ] && continue
        VIOLATIONS=$(git show ":$file" 2>/dev/null \
            | grep -nE 'Sprint [0-9]+|Task [0-9]+|\(S[0-9]+\)' || true)
        if [ -n "$VIOLATIONS" ]; then
            if [ "$FOUND_VIOLATIONS" = false ]; then
                echo "  [FAIL] Writing Audience violations in spec-facing documents:"
                FOUND_VIOLATIONS=true
            fi
            echo "     $file:"
            printf '%s\n' "$VIOLATIONS" | sed 's/^/       /'
        fi
    done <<< "$SPEC_FACING_STAGED"
    [ "$FOUND_VIOLATIONS" = true ] && PASS=false
fi

# ── Spec ↔ Code validation ─────────────────────────────────────────────────────
# Trigger: any spec contract document staged, OR any file under a configured binding's
#          src tree staged — catches drift from EITHER side changing alone, including
#          code changed directly without touching the spec.
# Catches: spec–code drift introduced alongside a spec update, or code silently
#          diverging from a spec that was never updated.
# Requires spec_code_bindings, or the legacy spec_code_adapter/spec_code_spec/
# spec_code_src trio, set in .project-starter.yml — skipped entirely (no check, no
# noise) when unset, matching prior default behavior. One verify_spec_code.py
# invocation per resolved binding — a project with a REST API and a background
# pipeline gets both checked, not just whichever was configured first.
SPEC_CONTRACT_STAGED=$(printf '%s\n' "$STAGED" \
    | grep -E '(pipeline-contract|cli-contract|api-contract|public-api|llm-contract|topology|mobile-contract)\.md$' || true)
if [ -n "$SPEC_CODE_BINDINGS" ] && [ -f "docs/script/validators/verify_spec_code.py" ]; then
    while IFS=$'\t' read -r B_ADAPTER B_SPEC B_SRC; do
        [ -z "$B_ADAPTER" ] && continue
        SRC_STAGED=$(printf '%s\n' "$STAGED" | grep -F "$B_SRC" || true)
        if [ -n "$SPEC_CONTRACT_STAGED" ] || [ -n "$SRC_STAGED" ]; then
            echo "  → verify_spec_code.py --adapter $B_ADAPTER (spec or src staged) ..."
            python3 "docs/script/validators/verify_spec_code.py" \
                --project-type "$PROJECT_TYPE" \
                --adapter "$B_ADAPTER" --spec "$B_SPEC" --src "$B_SRC" \
                --strict 2>&1 || PASS=false
        fi
    done <<< "$SPEC_CODE_BINDINGS"
fi

# ── Spec ↔ Code coverage tip (non-blocking) ────────────────────────────────────
# Trigger: a spec contract document is staged, but no binding (either config form)
# resolved to anything.
# Purpose: the drift gate above is entirely invisible when unset — a project can
# silently have zero spec<->code protection indefinitely. This surfaces that gap
# at the moment it actually matters (a spec contract is being committed) instead
# of depending on someone having read the optional setup docs beforehand.
if [ -z "$SPEC_CODE_BINDINGS" ] && [ -n "$SPEC_CONTRACT_STAGED" ]; then
    ADAPTERS=""
    case "$PROJECT_TYPE" in
        web-app|microservices)   ADAPTERS="fastapi, flask, django, express, gin" ;;
        cli-tool)                ADAPTERS="click, typer" ;;
        library)                 ADAPTERS="python_library, typescript" ;;
        data-pipeline|ml-pipeline) ADAPTERS="airflow, dagster, prefect, luigi" ;;
        llm-app)                 ADAPTERS="tool_schema, langchain" ;;
        iac)                     ADAPTERS="terraform, pulumi, ansible" ;;
        mobile-app)              ADAPTERS="react_native, flutter, swiftui" ;;
    esac
    if [ -n "$ADAPTERS" ]; then
        echo "  [TIP] No spec<->code drift protection configured for this project."
        echo "        Available adapters for '$PROJECT_TYPE': $ADAPTERS"
        echo "        Set spec_code_adapter / spec_code_spec / spec_code_src in .project-starter.yml"
        echo "        to catch drift automatically on every commit — see README.md -> Spec <-> Code Validator."
    fi
fi

# ── Security scan (SAST) ───────────────────────────────────────────────────────
# Trigger: any file under the configured security_scan_src tree staged.
# Requires security_scan_src set in .project-starter.yml — skipped entirely (no check,
# no noise) when unset, matching the spec<->code gate's opt-in pattern.
if [ -n "$SECURITY_SCAN_SRC" ] && [ -f "docs/script/validators/verify_security.py" ]; then
    SECURITY_SRC_STAGED=$(printf '%s\n' "$STAGED" | grep -F "$SECURITY_SCAN_SRC" || true)
    if [ -n "$SECURITY_SRC_STAGED" ]; then
        echo "  → verify_security.py --src $SECURITY_SCAN_SRC (src staged) ..."
        python3 "docs/script/validators/verify_security.py" \
            --project-type "$PROJECT_TYPE" --src "$SECURITY_SCAN_SRC" \
            --strict 2>&1 || PASS=false
    fi
fi

# ── Security scan coverage tip (non-blocking) ──────────────────────────────────
# Trigger: spec_code_src is already configured (so a src path is known), but
# security_scan_src isn't — this is the actionable moment to suggest enabling it,
# reusing an existing signal instead of adding new file-staging detection.
# Only checks the legacy single-trio $SPEC_CODE_SRC, not spec_code_bindings — a
# project using only the new multi-binding form loses this one suggestion message
# (nothing else), not worth the complexity of picking a src path out of a list for
# a non-blocking tip. Set security_scan_src by hand in that case.
if [ -z "$SECURITY_SCAN_SRC" ] && [ -n "$SPEC_CODE_SRC" ]; then
    echo "  [TIP] No SAST scan configured for this project."
    echo "        Set security_scan_src: $SPEC_CODE_SRC in .project-starter.yml to run bandit"
    echo "        (Python) / eslint-plugin-security (JS/TS) automatically on every commit —"
    echo "        see README.md -> Security Scan (SAST)."
fi

# ── Prose quality (Vale) ────────────────────────────────────────────────────────
# Trigger: any .md file under docs_path staged. Requires prose_scan_enabled: true in
# .project-starter.yml — skipped entirely (no check, no noise) when unset/false.
MD_STAGED=$(printf '%s\n' "$STAGED" | grep -E '\.md$' | grep -F "$DOCS_PATH" || true)
if [ "$PROSE_SCAN_ENABLED" = "true" ] && [ -f "docs/script/validators/verify_prose.py" ]; then
    if [ -n "$MD_STAGED" ]; then
        echo "  → verify_prose.py --docs $DOCS_PATH (*.md staged) ..."
        python3 "docs/script/validators/verify_prose.py" \
            --project-type "$PROJECT_TYPE" --docs "$DOCS_PATH" \
            --strict 2>&1 || PASS=false
    fi
fi

# ── Prose quality coverage tip (non-blocking) ───────────────────────────────────
if [ "$PROSE_SCAN_ENABLED" != "true" ] && [ -n "$MD_STAGED" ]; then
    echo "  [TIP] No prose-quality scan configured for this project."
    echo "        Set prose_scan_enabled: true in .project-starter.yml to run Vale on every"
    echo "        commit that touches docs — see README.md -> Prose Quality (Vale)."
fi

if [ "$PASS" = false ]; then
    echo ""
    echo "[FAIL] pre-commit: verification failed — commit blocked."
    echo "    Fix the issues above, then re-run: git commit"
    exit 1
fi

echo "[OK] pre-commit: all checks passed."
